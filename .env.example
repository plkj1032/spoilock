DB_HOST=localhost
DB_PORT=3306
DB_NAME=spoilock
DB_USERNAME=your_username
DB_PASSWORD=your_password

JWT_SECRET_BASE64=JWT_Key
COOKIE_SECURE=false

KAKAO_CLIENT_ID=카카오_REST_API_키
KAKAO_CLIENT_SECRET=새로_발급한_클라이언트_시크릿

VITE_API_TARGET=http://localhost:8080
VITE_WS_TARGET=ws://localhost:8080
VITE_WS_SECONDARY_URL=ws://localhost:8081/ws

# 스포일러 판별 AI 서버 (Python FastAPI)
SPOILER_API_BASE_URL=http://100.84.0.113:8000
# 로컬 데모: 미검증 사건 회차로 공개 판단 허용
SPOILER_ALLOW_UNVERIFIED_DEMO=true
# Python 사건 데이터(drama_id=1)에 해당하는 Spring dramas.id
SPOILER_DEMO_DRAMA_ID=1
SPOILER_PREFILTER_MODE=on
# Python 관리자 API 토큰 (Python .env 의 ADMIN_TOKEN 과 같은 값)
SPOILER_ADMIN_TOKEN=
SPOILER_PUBLISH_NO_MATCH=false
# 사건이 등록되지 않은 작품의 채팅·게시글 바로 공개 (false: 검토 대기로 보류)
SPOILER_PUBLISH_UNINDEXED_DRAMA=true
