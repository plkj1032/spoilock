--- a/frontend/src/styles/SoftNavyTheme.css
+++ b/frontend/src/styles/SoftNavyTheme.css
@@ -423,3 +423,57 @@
   outline: 2px solid #c2d1e4;
   outline-offset: 3px;
 }
+
+/* Subtle depth: neutral light over the existing navy, without extra hues.
+ * Adjust only these opacity tokens to tune the effect; 0 removes it.
+ */
+:root {
+  --soft-page-light: 0.018;
+  --soft-surface-light: 0.022;
+}
+
+#root {
+  background-image: radial-gradient(ellipse 100% 650px at 50% 0,
+    rgb(255 255 255 / var(--soft-page-light)), transparent 100%);
+  background-repeat: no-repeat;
+}
+
+#root .site-header,
+#root :is(.drama-card, .room-card, .chat-directory-card,
+  .chat-directory-tools, .feed-card, .feed-composer, .feed-page__tabs,
+  .mypage-panel, .mypage-drama-card, .mypage-room,
+  .chat-room-header, .chat-input-form) {
+  background-image: linear-gradient(150deg,
+    rgb(255 255 255 / var(--soft-surface-light)),
+    rgb(255 255 255 / 0) 85%);
+}
+
+/* Keep the same faint highlight when a card's background changes on hover. */
+#root :is(.room-card, .chat-directory-card, .mypage-room):hover:not(:disabled) {
+  background-image: linear-gradient(150deg,
+    rgb(255 255 255 / var(--soft-surface-light)),
+    rgb(255 255 255 / 0) 85%);
+}
+
+/* Header only: reduce the logo's real layout size, not its transform scale. */
+#root .site-header .brand.brand--playlock {
+  font-size: 22px;
+  gap: 8px;
+}
+
+#root .site-header .brand--playlock .brand-mark {
+  width: 30px;
+  height: 34px;
+}
+
+@media (max-width: 570px) {
+  #root .site-header .brand.brand--playlock {
+    font-size: 18px;
+    gap: 6px;
+  }
+
+  #root .site-header .brand--playlock .brand-mark {
+    width: 25px;
+    height: 28px;
+  }
+}
